{
  "manifest_version": 3,
  "name": "ICOS Bug Recorder",
  "version": "1.0.1",
  "description": "Capture user interactions for ICOS Claims application bug recreation",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
